{
  "name": "webinar-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:up": "node scripts/setup.mjs && docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:caddy:logs": "docker compose logs -f caddy",
    "docker:reload": "docker compose restart caddy",
    "dev:client": "pnpm --filter @webinar/desktop-client dev",
    "dev:api": "pnpm --filter @webinar/api dev",
    "startup": "node scripts/startup.mjs"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"  
  },
  "packageManager": "pnpm@9.1.0"
}
