DATABASE_URL=postgresql://webinar:webinar@localhost:5432/webinar_db
REDIS_URL=redis://localhost:6379
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
JWT_SECRET=your-secret-key-change-in-production
API_PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Public URL for invite/registration links and emails
PUBLIC_APP_URL=http://localhost:5173

# SMTP — registration confirmation emails (logs only if SMTP_HOST is empty)
#
# Gmail (dev):     smtp.gmail.com:587 — App Password from https://myaccount.google.com/apppasswords
# SendGrid (prod): smtp.sendgrid.net:587 — user=apikey, pass=API key from SendGrid dashboard
# Brevo:           smtp-relay.brevo.com:587 — credentials from Brevo → SMTP & API
#
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Whitebox Learning Webinars <webinars@whiteboxlearning.com>

# Native WebRTC (skip LiveKit token issuance when true)
USE_NATIVE_WEBRTC=false
# Public STUN servers — replace with your own if running a private STUN server.
STUN_URL=stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302
# TURN relay — required for symmetric NAT. Without this, the API warns on startup.
TURN_URL=turn:your-turn-server.example.com:3478
TURN_SECRET=webinar-turn-secret-change-me
TURN_TTL_SECONDS=3600

# Recording
LIVEKIT_EGRESS_ENABLED=true
RECORDINGS_ROOT=/var/recordings
