# Database
DATABASE_URL=postgresql://webinar:webinar@localhost:5432/webinar_db

# Redis
REDIS_URL=redis://localhost:6379

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devkey-local-secret-change-in-production-00
# IP advertised in WebRTC ICE candidates. Auto-detected on `pnpm docker:up`.
# Set to your LAN IP (ipconfig) when attendees join from other devices, e.g. 192.168.0.60
LIVEKIT_NODE_IP=

# JWT
JWT_SECRET=your-secret-key-change-in-production

# API
API_PORT=3000
API_HOST=localhost

# Public URL used when generating invite / registration links and emails.
PUBLIC_APP_URL=http://localhost:5173

# SMTP — registration confirmation emails (logged only when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Whitebox Learning Webinars <webinars@whiteboxlearning.com>

# Native WebRTC (set USE_NATIVE_WEBRTC=true on API + VITE_USE_NATIVE_WEBRTC=true on client)
USE_NATIVE_WEBRTC=false
# Public STUN servers (Google) — work for most open-internet scenarios.
# Replace with your own stun: URL if you run a private STUN server.
STUN_URL=stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302
# TURN relay — required for attendees behind symmetric NAT / corporate firewalls.
# Without these two vars the API will log a warning and TURN will be disabled.
TURN_URL=turn:your-turn-server.example.com:3478
TURN_SECRET=webinar-turn-secret-change-me
TURN_TTL_SECONDS=3600

# Worker
WORKER_CONCURRENCY=5

# Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=webinar-recordings
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Recording
LIVEKIT_EGRESS_ENABLED=true
RECORDINGS_ROOT=/var/recordings
FFMPEG_PATH=/usr/bin/ffmpeg
RECORDING_CLEANUP_RAW=false
RECORDING_DEFAULT_RESOLUTION=1080p

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=debug
