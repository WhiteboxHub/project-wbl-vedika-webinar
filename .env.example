# ═══════════════════════════════════════════════════════════════════════════════
# THE ONLY THING YOU EVER NEED TO CHANGE
#
# Run:  pnpm setup
# That auto-detects your LAN IP and fills these in for you.
#
# Options:
#   LAN only (same WiFi):  APP_HOST=192.168.0.60        (auto-detected)
#   Custom domain:         APP_HOST=webinar.yourdomain.com
#   Localhost only:        APP_HOST=localhost
# ═══════════════════════════════════════════════════════════════════════════════
APP_HOST=
APP_PORT=80
APP_PROTOCOL=http

# Derived from APP_HOST — set automatically by `pnpm setup`
PUBLIC_APP_URL=
BASE_URL=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://webinar:webinar@localhost:5444/webinar_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── LiveKit (WebRTC SFU) ─────────────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devkey-local-secret-change-in-production-00

# ICE candidate IP — set to same value as APP_HOST (auto-set by `pnpm setup`)
LIVEKIT_NODE_IP=

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-secret-key-change-in-production

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3000
API_HOST=localhost

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5

# ─── Storage (S3-compatible) ──────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=webinar-recordings
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ─── Recording ────────────────────────────────────────────────────────────────
LIVEKIT_EGRESS_ENABLED=true
RECORDINGS_ROOT=/var/recordings
FFMPEG_PATH=/usr/bin/ffmpeg
RECORDING_CLEANUP_RAW=false
RECORDING_DEFAULT_RESOLUTION=1080p

# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
