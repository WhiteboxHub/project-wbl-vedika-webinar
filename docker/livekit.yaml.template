port: 7880
bind_addresses:
  - "0.0.0.0"

rtc:
  # UDP port range for WebRTC media — must match docker-compose ports mapping.
  port_range_start: 50000
  port_range_end: 50020
  # IP advertised in ICE candidates. Set LIVEKIT_NODE_IP in .env (auto-detected on docker:up).
  # Use 127.0.0.1 only when host AND all attendees are on the same machine via localhost.
  # Use your LAN IP (e.g. 192.168.0.60) when attendees join from other devices on the network.
  node_ip: {{NODE_IP}}
  tcp_port: 7881
  enable_loopback_candidate: true

redis:
  address: redis:6379

keys:
  devkey: devkey-local-secret-change-in-production-00

logging:
  level: info
  sample: false

room:
  auto_create: true
  empty_timeout: 300
  max_participants: 100

# Embedded TURN helps attendees behind NAT / on different devices (port 3479 — coturn uses 3478).
turn:
  enabled: true
  domain: {{NODE_IP}}
  udp_port: 3479
