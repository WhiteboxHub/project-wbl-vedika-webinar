# ─── Database ─────────────────────────────────────────────────────────────────
# Note: Docker Compose maps Postgres to port 5444 to avoid conflicts with a
# local Postgres installation on the default 5432.
DATABASE_URL=postgresql://webinar:webinar@localhost:5444/webinar_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── LiveKit (WebRTC SFU) ─────────────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devkey-local-secret-change-in-production-00

# IP advertised in WebRTC ICE candidates.
# Leave empty for single-machine dev. Set to your LAN IP (e.g. 192.168.0.60)
# when attendees join from other devices on the same network.
# Run `ipconfig` (Windows) or `ifconfig` (macOS/Linux) to find your LAN IP.
LIVEKIT_NODE_IP=

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-secret-key-change-in-production

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3000
API_HOST=localhost

# ─── Public App URL ───────────────────────────────────────────────────────────
# Used when generating invite / registration links and confirmation emails.
# Leave empty to fall back to the webinar:// deep-link scheme (desktop-only).
# Example (production): https://app.yourdomain.com
PUBLIC_APP_URL=

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5

# ─── Storage (S3-compatible) ──────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=webinar-recordings
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ─── Recording ────────────────────────────────────────────────────────────────
LIVEKIT_EGRESS_ENABLED=true
RECORDINGS_ROOT=/var/recordings
FFMPEG_PATH=/usr/bin/ffmpeg
RECORDING_CLEANUP_RAW=false
RECORDING_DEFAULT_RESOLUTION=1080p

# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
