VITE_API_URL=http://localhost:3000

# Native WebRTC (must match API USE_NATIVE_WEBRTC=true)
VITE_USE_NATIVE_WEBRTC=false

# Optional build-time override for the public domain used in shareable links.
# Normally you don't need this — just set PUBLIC_APP_URL in the root .env
# and the API will serve it via GET /api/config automatically.
# Only set this if you're building a static bundle and can't use the API.
# VITE_PUBLIC_URL=https://your-tunnel-or-domain.com
