# ─── Database ─────────────────────────────────────────────────────────────────
# Note: Docker Compose maps Postgres to port 5444 to avoid conflicts with a
# local Postgres installation on the default 5432.
DATABASE_URL=postgresql://webinar:webinar@127.0.0.1:5444/webinar_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── LiveKit (WebRTC SFU) ─────────────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devkey-local-secret-change-in-production-00

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=jwt-local-secret-change-in-production-00000000

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ─── Public App URL ───────────────────────────────────────────────────────────
# URL the browser uses — attendees open this to join sessions.
# Change to your server's real URL for production (e.g. https://app.yourdomain.com).
PUBLIC_APP_URL=http://localhost:5173

# ─── Admin / Organizer Credentials ───────────────────────────────────────────
# Simple local admin login — change both values before deploying to production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# ─── SMTP — Registration & confirmation emails ────────────────────────────────
# When SMTP_HOST is empty, emails are printed to the console (safe for local dev).
#
# Gmail (dev):     smtp.gmail.com:587
#   → SMTP_PASS must be a 16-char App Password (not your regular password).
#   → Generate one at https://myaccount.google.com/apppasswords (2FA required).
#
# SendGrid (prod): smtp.sendgrid.net:587
#   → SMTP_USER=apikey  SMTP_PASS=<your SendGrid API key>
#
# Brevo (prod):    smtp-relay.brevo.com:587
#   → Credentials from Brevo dashboard → SMTP & API
#
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Whitebox Learning Webinars <webinars@whiteboxlearning.com>

# ─── Recording ────────────────────────────────────────────────────────────────
LIVEKIT_EGRESS_ENABLED=true
RECORDINGS_ROOT=/var/recordings

# ─── Native WebRTC / TURN ─────────────────────────────────────────────────────
# Set USE_NATIVE_WEBRTC=true to bypass LiveKit and use the built-in
# peer-to-peer WebRTC signaling path instead.
USE_NATIVE_WEBRTC=false

# STUN servers — used for ICE candidate discovery.
# Replace with your own STUN URL if running a private STUN server.
STUN_URL=stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302

# TURN relay — required for attendees behind symmetric NAT / corporate firewalls.
# Without TURN_URL set, the API will log a startup warning and TURN will be disabled.
TURN_URL=turn:your-turn-server.example.com:3478
TURN_SECRET=webinar-turn-secret-change-me
TURN_TTL_SECONDS=3600
